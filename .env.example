# Copy to .env.local and fill in. Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL (lib/site-url.ts falls back NEXT_PUBLIC_SITE_URL -> NEXT_PUBLIC_APP_URL -> VERCEL_URL) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
# Used only by app/api/sessions/bookings/[id]/prepare as a fallback
SITE_URL=

# --- Admin / internal auth ---
ADMIN_PASSWORD=
# HMAC key for the admin session cookie; falls back to ADMIN_PASSWORD if unset
ADMIN_SESSION_SECRET=
CRON_SECRET=
INTERNAL_API_SECRET=
ADMIN_API_SECRET=

# --- Iyzico ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM=
CONTACT_TO=
ADMIN_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# --- Analytics / SEO ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set automatically by Next.js / Vercel — do not define manually:
# NODE_ENV, VERCEL_URL
